# .env.example
# Copy this file to .env and fill in the real values.
# Warning: never commit .env to Git.

# ── LLM API Keys ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-enter_your_real_key_here
OPENAI_API_KEY=sk-enter_your_real_key_here

# ── LLM Settings ──────────────────────────────────────
DEFAULT_LLM_PROVIDER=claude          # claude | openai
DEFAULT_MODEL=claude-opus-4-5
MAX_TOKENS=4096

# ── Memory Backend ──────────────────────────────────────
MEMORY_BACKEND=in_memory             # in_memory | redis
REDIS_URL=redis://localhost:6379

# ── Autonomy Level ────────────────────────────────────────
AUTONOMY_LEVEL=supervised            # supervised | semi_auto | autonomous

# ── Observability ──────────────────────────────────────────────
ENABLE_TRACING=true
LOG_LEVEL=INFO

# ── File Sandbox ──────────────────────────────────────────────
SANDBOX_DIR=/tmp/agent_sandbox

# ── Slack (optional) ───────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Protocols (optional) ───────────────────────────────────
ENABLE_MCP_SERVER=false
MCP_SERVER_PORT=8080
A2A_BASE_URL=http://localhost:8080
A2A_AGENT_NAME=my-agent

# ── Evaluation ──────────────────────────────────────────────
EVAL_PASS_THRESHOLD=0.7
